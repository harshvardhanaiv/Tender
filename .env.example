# TenderFlow — environment template. Copy to .env (dev) or .env.production (prod) and fill in values.
# Only this template belongs in git; the real files are gitignored.

# Flask
PORT=8092
FLASK_SECRET_KEY=generate-with-python-secrets-token_hex-32
SESSION_COOKIE_SECURE=0
APP_BASE_URL=http://localhost:8092
# Background schedulers (deadline emails, award scraping); docker-compose.yml sets 0 for local dev
ENABLE_SCHEDULERS=1

# DeepSeek AI
DEEPSEEK_API_KEY=
# Market Radar > Insights (per-buyer AI summary, DeepSeek only). 0 hides the Insights button and its routes.
ENABLE_BUYER_INSIGHTS=1

# PostgreSQL (required — the only database the app uses)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=

# Firebase Auth (server)
FIREBASE_PROJECT_ID=tender-8f886
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
# Or inline JSON (single line):
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# Firebase Auth (client — from Firebase console → Project settings)
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=tender-8f886.firebaseapp.com
FIREBASE_APP_ID=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# 1 = VAT/sales tax via Stripe Tax (requires head office address in Dashboard)
STRIPE_AUTOMATIC_TAX=0
# From: python scripts/setup_stripe_portal.py
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_PRODUCT_STANDARD=prod_...
STRIPE_PRICE_STANDARD_MONTHLY=price_...
STRIPE_PRODUCT_ADVANCE=prod_...
STRIPE_PRICE_ADVANCE_MONTHLY=price_...
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_BUSINESS_MONTHLY=price_...
STRIPE_PRICE_BUSINESS_ANNUAL=price_...
STRIPE_PRICE_PACK_100=price_...
STRIPE_PRICE_PACK_300=price_...
STRIPE_PRICE_PACK_1000=price_...

# Credits
FREE_TRIAL_CREDITS=25
LOW_CREDIT_THRESHOLD=10

# Admin (comma-separated emails)
ADMIN_EMAILS=you@company.com

# Observability (optional)
SENTRY_DSN=

# Email (optional — welcome / low credit / deadline alerts)
EMAIL_FROM=noreply@yourdomain.com
SMTP_FROM_NAME=TenderFlow
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Traefik (production docker-compose only)
APP_HOST=tender.civenta.co.uk
TRAEFIK_CERT_RESOLVER=letsencrypt
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# Optional: model used when a user picks that provider but no explicit model.
# ANTHROPIC_DEFAULT_MODEL=claude-sonnet-5
# GEMINI_DEFAULT_MODEL=gemini-1.5-flash

# Market Radar "Company profile" drawer. Each source is optional; a missing key shows "not connected".
# Companies House REST API key (free, developer.company-information.service.gov.uk): filings + owners.
COMPANIES_HOUSE_API_KEY=
# Google Places API (New) key: overall Google rating and review count.
GOOGLE_PLACES_API_KEY=
